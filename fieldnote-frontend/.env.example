# Local FastAPI endpoint used by Vite. Do not put secrets in frontend env files.
VITE_API_URL=http://127.0.0.1:8000/api
VITE_DEVELOPER_MODE=0
# Publiczne parametry klienta Supabase Auth. Nigdy nie wpisuj service-role key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=local-anon-key
